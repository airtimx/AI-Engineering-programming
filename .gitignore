# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
**/local.settings.json

# Logs & temp
*.log
tmp/
temp/
.cache/

# PowerShell
*.ps1xml.bak

# Optional local overrides
AIWORKSPACE.local.ps1

# Local trash from init garbled-doc recovery (keep .gitkeep if present)
codestatrFirst/.trash/*
!codestatrFirst/.trash/.gitkeep
workspace/.trash/*
!workspace/.trash/.gitkeep

# Runtime file locks (keep .gitkeep)
codestatrFirst/.locks/*
!codestatrFirst/.locks/.gitkeep
workspace/.locks/*
!workspace/.locks/.gitkeep
*.lock

# Batch resume cursor (local)
codestatrFirst/cache/.batch-progress.json
workspace/cache/.batch-progress.json

# Pester / local
TestResults.xml
coverage.xml
dist/
